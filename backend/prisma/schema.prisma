generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  nim           String?   @unique
  affiliation   String?
  bio           String?
  avatarUrl     String?
  interests     String[]  @default([])
  role          String    @default("member") // "member", "moderator", "admin"
  isActive      Boolean   @default(true)
  resetToken    String?  @unique
  resetTokenExpiry DateTime?
  mustChangePassword Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  articles      Article[]
  eventsCreated Event[]   @relation("EventCreator")
  registrations Registration[]
  comments      Comment[]
  officialLetters OfficialLetter[] @relation("LetterCreator")

  @@map("members")
}

model Article {
  id            Int       @id @default(autoincrement())
  title         String
  slug          String    @unique
  content       String
  references    String?   // daftar pustaka, satu entri per baris
  excerpt       String?
  imageUrl      String?
  authorId      Int
  author        Member    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  topic         String?   @default("General")
  tags          String[]  @default([])
  status        String    @default("draft") // "draft", "submitted", "published", "archived"
  viewCount     Int       @default(0)
  isFeatured    Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  comments      Comment[]

  @@map("articles")
}

model Event {
  id            Int       @id @default(autoincrement())
  title         String
  slug          String    @unique
  description   String
  dateTime      DateTime
  location      String?
  onlineUrl     String?
  capacity      Int?
  createdById   Int
  createdBy     Member    @relation("EventCreator", fields: [createdById], references: [id])
  status        String    @default("upcoming") // "upcoming", "completed", "cancelled"
  imageUrl      String?
  category      String    @default("umum") // "umum", "internal"
  presensiCode  String? // kode presensi per kegiatan (anti titip absen); null = tanpa kode
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  registrations Registration[]

  @@map("events")
}

model Registration {
  id            Int       @id @default(autoincrement())
  eventId       Int
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId      Int?
  member        Member?   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name          String?
  email         String?
  phone         String?
  institution   String?
  nim           String?
  registeredAt  DateTime  @default(now())
  attended      Boolean   @default(false)
  presensiIp    String? // IP pengirim saat check-in (jejak audit anti-manipulasi)

  @@map("registrations")
}

model NewsletterSubscriber {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  name          String?
  interestedTopics String[] @default([])
  isVerified    Boolean   @default(false)
  verificationToken String?
  subscribedAt  DateTime  @default(now())
  unsubscribedAt DateTime?

  @@map("newsletter_subscribers")
}

model Comment {
  id            Int       @id @default(autoincrement())
  articleId     Int
  article       Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  memberId      Int
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  content       String
  isApproved    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("comments")
}

model Achievement {
  id        Int       @id @default(autoincrement())
  name      String
  title     String
  year      String
  event     String?
  category  String    @default("konferensi") // "kompetisi", "jurnal", "konferensi"
  initials  String
  photo     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("achievements")
}

model Officer {
  id        Int       @id @default(autoincrement())
  name      String
  position  String
  category  String    @default("bph") // "bph", "divisi_kajian", "divisi_advokasi", "divisi_psdm", "divisi_publikasi"
  order     Int       @default(0)
  photo     String?
  initials  String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("officers")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model OfficialLetter {
  id              String         @id @default(uuid())
  letterNumber    String         @unique
  sequenceNumber  Int
  subjectCode     String         // Kode perihal: 01 s.d. 11
  scope           String         // PUSAT, DIVISI, KEPANITIAAN
  divisionCode    String?        // KR, AD, PD, PR
  committeeCode   String?        // PTA-UPGR, etc.
  subject         String         // Perihal surat
  recipientName   String         // Nama Penerima
  recipientOrg    String?        // Instansi / Lembaga
  eventDate       DateTime?
  contentData     Json?          // payload dinamis (daftar mahasiswa, detail agenda)
  withSignature   Boolean        @default(true)
  withStamp       Boolean        @default(true)
  status          String         @default("ISSUED") // DRAFT, ISSUED, VOID
  filePdfUrl      String?
  issuedAt        DateTime       @default(now())
  createdById     Int
  createdBy       Member         @relation("LetterCreator", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([letterNumber])
  @@index([subjectCode])
  @@index([issuedAt])
  @@map("official_letters")
}

model LetterSequence {
  year      Int
  scopeKey  String         @default("GLOBAL") // Identifier scope counter
  lastSeq   Int            @default(0)

  @@id([year, scopeKey])
  @@map("letter_sequences")
}
